# Browser Configuration
# Options: chrome, firefox, safari
BROWSER=chrome
# Set to "true" to run in headed mode (browser visible), otherwise headless
HEADED=true

# Application Configuration
BASE_URL=https://www.saucedemo.com/

# Viewport Configuration (optional)
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080

# Node Environment
NODE_ENV=test

# Self-healing locator service (optional; defaults shown)
HEAL_API_URL=http://localhost:8787
HEAL_THRESHOLD=0.4
# Set to "false" to skip heal-on-failure attachments when the service is unavailable
HEAL_ON_FAILURE=true
# Retry failed login steps once after a successful heal (uses healed XPath). "false" = fail fast, no retry.
# Heal JSON still attaches on failure when HEAL_ON_FAILURE=true. Unset mirrors HEAL_ON_FAILURE.
# HEAL_LOCATOR_RETRY=true
