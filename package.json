{
  "name": "playwright-bdd-framework",
  "version": "1.0.0",
  "description": "Playwright + Cucumber BDD test framework (playwright-bdd runner)",
  "scripts": {
    "bddgen": "bddgen",
    "test:bdd": "bddgen && playwright test",
    "test:bdd:with-report": "npm run test:bdd && npm run report",
    "test:bdd:no-report": "bddgen && playwright test",
    "test:bdd:smoke": "bddgen && playwright test --grep @smoke",
    "test:bdd:headed": "HEADED=true bddgen && HEADED=true playwright test",
    "report": "node reporting/patch-mchr-scenarios.cjs && ts-node src/utils/generate-report.ts",
    "report:open": "npm run report && open test-results/cucumber-html-report/index.html"
  },
  "keywords": [
    "playwright",
    "cucumber",
    "bdd",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.10.0",
    "dotenv": "^16.3.1",
    "multiple-cucumber-html-reporter": "^3.9.3",
    "playwright-bdd": "^9.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
