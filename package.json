{
  "name": "playwright-bdd-framework",
  "version": "1.0.0",
  "description": "Playwright + Cucumber BDD test framework",
  "scripts": {
    "test:bdd": "cucumber-js",
    "test:bdd:with-report": "npm run test:bdd",
    "test:bdd:no-report": "SKIP_AUTO_HTML_REPORT=1 cucumber-js",
    "test:bdd:smoke": "cucumber-js --tags @smoke",
    "test:bdd:headed": "HEADED=true cucumber-js",
    "report": "node reporting/patch-mchr-scenarios.cjs && ts-node src/utils/generate-report.ts",
    "report:open": "npm run report && open test-results/cucumber-html-report/index.html"
  },
  "keywords": [
    "playwright",
    "cucumber",
    "bdd",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@cucumber/cucumber": "^10.9.0",
    "@cucumber/pretty-formatter": "^2.4.1",
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.10.0",
    "dotenv": "^16.3.1",
    "multiple-cucumber-html-reporter": "^3.9.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
